          "family": "counterfactual",
          "documents": [
            {"id": "D1", "text": "Courier Vela routes through Cedarholm."},
            {"id": "D2", "text": "Aldermere uses the Galdite seal."},
            {"id": "D3", "text": "The Aldermere registry independently lists the Galdite seal."},
            {"id": "D4", "text": "Bramblecross uses the Hesper seal."},
            {"id": "D5", "text": "Cedarholm uses the Orphic seal."},
            {"id": "D6", "text": "Maintenance inspection was completed."}
