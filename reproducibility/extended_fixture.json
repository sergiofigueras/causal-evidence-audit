      "question": "Which seal is assigned to courier Vela?",
      "conditions": [
        {
          "id": "baseline",
          "family": "baseline",
          "documents": [
            {"id": "D1", "text": "Courier Vela routes through Aldermere."},
            {"id": "D2", "text": "Aldermere uses the Galdite seal."},
            {"id": "D3", "text": "The Aldermere registry independently lists the Galdite seal."},
            {"id": "D4", "text": "Bramblecross uses the Hesper seal."},
            {"id": "D5", "text": "Cedarholm uses the Orphic seal."},
            {"id": "D6", "text": "Maintenance inspection was completed."}
          ],
          "expected_answer": "Galdite",
          "proof_sets": [["D1", "D2"], ["D1", "D3"]],
          "changed_document_ids": [],
          "removed_document_ids": [],
          "rationale": "D1 supplies Vela's depot; D2 and D3 are independent sufficient seal records for that depot."
        },
        {
          "id": "route-bramblecross",
          "family": "counterfactual",
