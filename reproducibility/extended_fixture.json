          "documents": [
            {"id": "D1", "text": "Courier Vela routes through Aldermere."},
            {"id": "D2", "text": "Aldermere uses the Galdite seal."},
            {"id": "D3", "text": "The Aldermere registry independently lists the Galdite seal."},
