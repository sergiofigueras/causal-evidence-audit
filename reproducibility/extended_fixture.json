            {"id": "D5", "text": "Cedarholm uses the Orphic seal."},
            {"id": "D6", "text": "Maintenance inspection was completed."}
          ],
          "expected_answer": "Hesper",
          "proof_sets": [["D1", "D4"]],
          "changed_document_ids": ["D1"],
          "removed_document_ids": [],
          "rationale": "Only Vela's depot changes; the Hesper answer requires D1 and D4."
        },
        {
